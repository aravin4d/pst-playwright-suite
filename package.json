{
  "name": "pst-playwright-suite",
  "version": "1.1.0",
  "private": true,
  "description": "Playwright UI, API and accessibility tests for the Practice Software Testing toolshop",
  "author": "Aravind Natarajan",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=mobile",
    "test:headed": "playwright test --project=chromium --headed",
    "debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
